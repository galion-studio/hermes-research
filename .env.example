# Galion One voice, the product this workspace connects to. Not a copy of that page.
# Host copy for the systemd unit: deploy/research.env.example → /etc/galion/research.env
# Leave the key empty here. The real key stays on the host.
GALION_ONE_URL=https://galion.app/one

# galion-one-voice /research origin. Unset uses Hermes on this machine, then local knowledge.
# GALION_RESEARCH_URL=https://galion.app

# Hermes, the research agent. The key stays in the environment. Never commit it.
# GALION_LLM=hermes
# GALION_LLM_URL=http://127.0.0.1:8642/v1/chat/completions
# GALION_LLM_MODEL=hermes-agent
# GALION_LLM_KEY=
# GALION_LLM_TIMEOUT_MS=3000

PORT=8787
