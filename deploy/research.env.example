# Copy to /etc/galion/research.env on the host. Mode 0600. Owner galion.
# This example holds no secret. Leave the key empty in git. Set it only on the host.
# The unit pins PORT=8787 and binds 127.0.0.1 in src/server.js.

GALION_ONE_URL=https://galion.app/one

# Loopback openmind-desktop. GET /one and GET /research are its entry pages.
# A value that is not loopback http is refused and is not dialed. See docs/FORWARD.md.
# GALION_OPENMIND_URL=http://127.0.0.1:18181

# Loopback galion-one-voice web surface. GET /health answers the text ok.
# When this is set it is the voice upstream. A non-loopback value is refused.
# GALION_VOICE_URL=

# Older research origin. Used only when GALION_VOICE_URL is unset.
# Loopback http only. An https value is refused and is not dialed.
# GALION_RESEARCH_URL=

# How long one upstream exchange may take, in milliseconds. Default 4000, clamped from 50 to 4000.
# GALION_UPSTREAM_TIMEOUT_MS=4000

# How long a forwarded POST /research/ask may take, in milliseconds. The voice desk gives Hermes 85000.
# Default 90000, clamped from 50 to 95000 (Cloudflare drops an origin reply after 100 s).
# GALION_ASK_TIMEOUT_MS=90000

# Hermes, the research agent. The key stays in this file on the host. Never commit it.
# GALION_LLM=hermes
# GALION_LLM_URL=http://127.0.0.1:8642/v1/chat/completions
# GALION_LLM_MODEL=hermes-agent
# GALION_LLM_KEY=
# Clamped from 50 to 95000. Match the voice desk with 85000.
# GALION_LLM_TIMEOUT_MS=3000

PORT=8787
