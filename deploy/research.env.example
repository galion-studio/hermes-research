# Copy to /etc/galion/research.env on the host. Mode 0600. Owner galion.
# This example holds no secret. Leave the key empty in git. Set it only on the host.
# The unit pins PORT=8787 and binds 127.0.0.1 in src/server.js.

GALION_ONE_URL=https://galion.app/one

# galion-one-voice /research origin. Unset uses Hermes on this machine, then local knowledge.
# The unit allows localhost only, so a public origin does not connect until a human changes that policy.
# GALION_RESEARCH_URL=https://galion.app

# Hermes, the research agent. The key stays in this file on the host. Never commit it.
# GALION_LLM=hermes
# GALION_LLM_URL=http://127.0.0.1:8642/v1/chat/completions
# GALION_LLM_MODEL=hermes-agent
# GALION_LLM_KEY=
# GALION_LLM_TIMEOUT_MS=3000

PORT=8787
