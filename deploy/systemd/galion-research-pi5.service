# Galion Research desk, Pi 5 seed. Loopback only.
# The binary binds 127.0.0.1. This unit pins PORT=8787, so the listener is 127.0.0.1:8787.
# ExecStart is the single executable. The Pi does not need Node installed.
# The key is not set here. A human puts it in /etc/galion/research.env on the host.
# Do not add the key, a credential path, or a credential directive to this file. See docs/DEPLOY.md.
# MemoryMax is the 256M ceiling named for the galion-voice unit draft. It is a cap, not a measured size.
# Do not enable this together with galion-research.service. Both listen on 8787.
[Unit]
Description=Galion Research desk, Pi 5 seed (loopback 127.0.0.1:8787)
After=network.target
Documentation=file:/opt/galion/research/current/docs/PI5-SEED.md

[Service]
Type=simple
User=galion
Group=galion
WorkingDirectory=/opt/galion/research/current
ExecStart=/opt/galion/research/current/galion-research
EnvironmentFile=-/etc/galion/research.env
Environment=PORT=8787
Environment=HOME=/var/lib/galion-research
StateDirectory=galion-research
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=256M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galion-research-pi5

[Install]
WantedBy=multi-user.target
